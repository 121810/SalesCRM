@using BiristaCRM.Enums
@using BiristaCRM.ViewModels
@model List<BiristaCRM.Models.ClientMaster>
@{
    ViewData["Title"] = "Customers";
    var filter = ViewBag.Filter as ClientFilterViewModel ?? new ClientFilterViewModel();
    var areas = ViewBag.Areas as List<string> ?? new List<string>();
}

<div class="sf-page-enter">
    <div class="sf-page-header">
        <div>
            <h2>Customers</h2>
            <p>Manage prospects and customers across your sales territories.</p>
        </div>
        <div class="sf-page-actions">
            <a asp-controller="Client" asp-action="Create" class="sf-btn sf-btn-primary">
                <i class="bi bi-plus-lg"></i>
                Add Customer
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="get" asp-action="Index" class="sf-toolbar" data-sf-search>
        <div class="row g-3 align-items-end">
            <div class="col-lg-3">
                <label class="form-label">Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="Search" value="@filter.Search" class="form-control" placeholder="Business, owner, or mobile" />
                </div>
            </div>
            <div class="col-lg-2">
                <label class="form-label">Area</label>
                <select name="Area" class="form-select">
                    <option value="">All areas</option>
                    @foreach (var area in areas)
                    {
                        <option value="@area" selected="@(filter.Area == area)">@area</option>
                    }
                </select>
            </div>
            <div class="col-lg-2">
                <label class="form-label">Status</label>
                <select name="Status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (ClientStatus status in Enum.GetValues(typeof(ClientStatus)))
                    {
                        <option value="@((int)status)" selected="@(filter.Status == status)">@status</option>
                    }
                </select>
            </div>
            <div class="col-lg-2">
                <label class="form-label">Active</label>
                <select name="IsActive" class="form-select">
                    <option value="">All</option>
                    <option value="true" selected="@(filter.IsActive == true)">Active</option>
                    <option value="false" selected="@(filter.IsActive == false)">Inactive</option>
                </select>
            </div>
            <div class="col-lg-1">
                <button type="submit" class="sf-btn sf-btn-primary w-100 justify-content-center">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>
            <div class="col-lg-2">
                <a asp-action="Index" class="sf-btn sf-btn-ghost w-100 justify-content-center">
                    <i class="bi bi-arrow-clockwise"></i>
                    Reset
                </a>
            </div>
        </div>
    </form>

    <div class="sf-panel">
        <div class="sf-panel-header">
            <div>
                <h5>Customer directory</h5>
                <span class="sf-panel-sub">@Model.Count total records</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="sf-table">
                <thead>
                    <tr>
                        <th>Business</th>
                        <th>Owner</th>
                        <th>Mobile</th>
                        <th>Area</th>
                        <th>Status</th>
                        <th>Active</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var client in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="sf-avatar">
                                            @client.BusinessName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="sf-cell-strong">@client.BusinessName</div>
                                            <div class="d-flex align-items-center gap-1">
                                                <small class="text-muted">
                                                    @(string.IsNullOrWhiteSpace(client.Email) ? "—" : client.Email)
                                                </small>
                                                @if (!string.IsNullOrWhiteSpace(client.Email))
                                                {
                                                    <button type="button" class="sf-btn-copy btn-copy" data-email="@client.Email" title="Copy email">
                                                        <i class="bi bi-copy"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>@client.OwnerName</td>
                                <td>@client.MobileNumber</td>
                                <td>@client.Area</td>
                                <td>
                                    @switch (client.Status)
                                    {
                                        case ClientStatus.Prospect:
                                            <span class="sf-badge sf-badge-warning"><span class="sf-status-dot"></span> Prospect</span>
                                            break;
                                        case ClientStatus.Customer:
                                            <span class="sf-badge sf-badge-success"><span class="sf-status-dot"></span> Customer</span>
                                            break;
                                        case ClientStatus.Inactive:
                                            <span class="sf-badge sf-badge-danger"><span class="sf-status-dot"></span> Inactive</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="sf-switch-row">
                                        <label class="sf-switch">
                                            <input type="checkbox" disabled @(client.IsActive ? "checked" : null) />
                                            <span class="sf-slider"></span>
                                        </label>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="GetSingleClientDetails"
                                           asp-route-id="@client.Id"
                                           class="sf-btn-icon btn-view"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@client.Id" class="sf-btn-icon" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@client.Id" method="post" onsubmit="return confirm('Delete this customer?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="sf-btn-icon danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="sf-empty">
                                    <i class="bi bi-people"></i>
                                    <h5>No customers yet</h5>
                                    <p>Click Add Customer to create your first record.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="sf-pagination">
            <div>
                @if (Model.Any())
                {
                    <span>Showing <strong>1</strong>–<strong>@Model.Count</strong> of <strong>@Model.Count</strong></span>
                }
                else
                {
                    <span>No customers available</span>
                }
            </div>
            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item disabled"><a class="page-link">Previous</a></li>
                    <li class="page-item active"><a class="page-link">1</a></li>
                    <li class="page-item disabled"><a class="page-link">Next</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<div class="position-fixed bottom-0 end-0 p-3" style="z-index:1080">
    <div id="copyToast" class="toast align-items-center text-bg-success border-0">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle-fill"></i>
                Email copied successfully.
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete this customer? This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="sf-btn sf-btn-ghost" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div>
