@using BiristaCRM.Enums
@model BiristaCRM.ViewModels.CreateOrderViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Order" : "New Order";
    var actionName = Model.Id.HasValue ? "Edit" : "Create";
}

<div class="sf-page-enter">
    <div class="sf-page-header">
        <div>
            <a asp-action="Index" class="sf-back-link"><i class="bi bi-arrow-left"></i> Back to orders</a>
            <h2>@ViewData["Title"]</h2>
            <p>Create and manage customer orders.</p>
        </div>
    </div>

    <form asp-action="@actionName" asp-route-id="@Model.Id" method="post" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="sf-panel">
            <div class="sf-panel-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ClientId" class="form-label">Client</label>
                        <select asp-for="ClientId" class="form-select" asp-items="ViewBag.Clients">
                            <option value="">Select client</option>
                        </select>
                        <span asp-validation-for="ClientId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProductId" class="form-label">Product</label>
                        <select asp-for="ProductId" class="form-select" asp-items="ViewBag.Products">
                            <option value="">Select product</option>
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="OrderDate" class="form-label"></label>
                        <input asp-for="OrderDate" class="form-control" type="datetime-local" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Quantity" class="form-label"></label>
                        <input asp-for="Quantity" class="form-control" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Rate" class="form-label"></label>
                        <input asp-for="Rate" class="form-control" />
                        <span asp-validation-for="Rate" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PaymentMode" class="form-label"></label>
                        <select asp-for="PaymentMode" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMode>()"></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PaymentStatus" class="form-label"></label>
                        <select asp-for="PaymentStatus" class="form-select" asp-items="Html.GetEnumSelectList<PaymentStatus>()"></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PaymentDate" class="form-label"></label>
                        <input asp-for="PaymentDate" class="form-control" type="datetime-local" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Remark" class="form-label"></label>
                        <textarea asp-for="Remark" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="sf-form-footer">
            <a asp-action="Index" class="sf-btn sf-btn-ghost">Cancel</a>
            <button type="submit" class="sf-btn sf-btn-primary"><i class="bi bi-check-lg"></i> Save order</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
