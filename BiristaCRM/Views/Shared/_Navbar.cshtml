@using BiristaCRM.Enums
@using BiristaCRM.Interfaces
@inject ICurrentUserService CurrentUser
@{
    string RoleLabel() => CurrentUser.Role switch
    {
        UserRole.SuperAdmin => "Super Admin",
        UserRole.Admin => "Company Admin",
        UserRole.SalesManager => "Sales Manager",
        _ => "Sales Person"
    };
}
<nav class="sf-navbar">
    <div class="sf-navbar-left">
        <button type="button" class="sf-menu-btn" id="sfMenuBtn" aria-label="Toggle sidebar">
            <i class="bi bi-list"></i>
        </button>
        <h4 class="sf-page-title">@ViewData["Title"]</h4>
    </div>

    <div class="sf-navbar-center">
        <div class="sf-search">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Search clients, products, orders..." />
        </div>
    </div>

    <div class="sf-navbar-right">
        <div class="sf-live-pill" title="System online">
            <span class="sf-live-dot"></span>
            <span>Online</span>
        </div>

        <div class="dropdown">
            <div class="sf-profile" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="~/images/avtar.png" alt="Profile" />
                <div class="sf-profile-meta">
                    <h6>@(string.IsNullOrWhiteSpace(CurrentUser.FullName) ? "User" : CurrentUser.FullName.Split(' ')[0])</h6>
                    <small>@RoleLabel()</small>
                </div>
            </div>
            <ul class="dropdown-menu dropdown-menu-end sf-dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-person me-2"></i>Profile</a></li>
                <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear me-2"></i>Settings</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-controller="Login" asp-action="Logout" method="post" class="px-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item border-0 bg-transparent w-100 text-start">
                            <i class="bi bi-box-arrow-right me-2"></i>Sign out
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>
