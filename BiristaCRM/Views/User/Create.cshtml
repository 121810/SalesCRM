@using BiristaCRM.Enums
@using BiristaCRM.Interfaces
@inject ICurrentUserService CurrentUser
@model BiristaCRM.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = CurrentUser.IsSuperAdmin ? "Invite User" : "Add SalesPerson";
}

<div class="sf-page-enter">
    <div class="sf-page-header">
        <div>
            <a asp-action="Index" class="sf-back-link"><i class="bi bi-arrow-left"></i> Back to @(CurrentUser.IsSuperAdmin ? "users" : "sales persons")</a>
            <h2>@(CurrentUser.IsSuperAdmin ? "Invite User" : "Add SalesPerson")</h2>
            <p>Create login credentials for a sales team member.</p>
        </div>
    </div>

    <form asp-action="Create" method="post" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="sf-panel">
            <div class="sf-panel-body">
                <div class="row g-3">
                    @if (CurrentUser.IsSuperAdmin)
                    {
                        <div class="col-md-6">
                            <label asp-for="CompanyId" class="form-label">Company</label>
                            <select asp-for="CompanyId" class="form-select" asp-items="ViewBag.Companies">
                                <option value="">Select company</option>
                            </select>
                            <span asp-validation-for="CompanyId" class="text-danger"></span>
                        </div>
                    }
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Mobile" class="form-label"></label>
                        <input asp-for="Mobile" class="form-control" maxlength="10" />
                        <span asp-validation-for="Mobile" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label"></label>
                        <select asp-for="Role" class="form-select" asp-items="ViewBag.Roles"></select>
                    </div>
                    @if (!CurrentUser.IsSuperAdmin)
                    {
                        <div class="col-md-6">
                            <label asp-for="ManagerId" class="form-label">Manager</label>
                            <select asp-for="ManagerId" class="form-select" asp-items="ViewBag.Managers">
                                <option value="">None</option>
                            </select>
                        </div>
                    }
                    <div class="col-md-6">
                        <label class="form-label">Active</label>
                        <div class="sf-switch-row">
                            <label class="sf-switch">
                                <input asp-for="IsActive" />
                                <span class="sf-slider"></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="sf-form-footer">
            <a asp-action="Index" class="sf-btn sf-btn-ghost">Cancel</a>
            <button type="submit" class="sf-btn sf-btn-primary"><i class="bi bi-check-lg"></i> @(CurrentUser.IsSuperAdmin ? "Create user" : "Save SalesPerson")</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
