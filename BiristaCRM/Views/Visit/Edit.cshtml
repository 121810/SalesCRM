@using BiristaCRM.Enums
@model BiristaCRM.ViewModels.CreateVisitViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Visit" : "Log Visit";
    var actionName = Model.Id.HasValue ? "Edit" : "Create";
}

<div class="sf-page-enter">
    <div class="sf-page-header">
        <div>
            <a asp-action="Index" class="sf-back-link"><i class="bi bi-arrow-left"></i> Back to visits</a>
            <h2>@ViewData["Title"]</h2>
            <p>Record customer visit details, samples, and follow-ups.</p>
        </div>
    </div>

    <form asp-action="@actionName" asp-route-id="@Model.Id" method="post" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="sf-panel">
            <div class="sf-panel-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ClientId" class="form-label">Customer</label>
                        <select asp-for="ClientId" class="form-select" asp-items="ViewBag.Clients">
                            <option value="">Select customer</option>
                        </select>
                        <span asp-validation-for="ClientId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProductId" class="form-label">Product</label>
                        <select asp-for="ProductId" class="form-select" asp-items="ViewBag.Products">
                            <option value="">Select product</option>
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="VisitDate" class="form-label"></label>
                        <input asp-for="VisitDate" class="form-control" type="date" value="@(Model.VisitDate.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<VisitStatus>()"></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CustomerResponse" class="form-label"></label>
                        <select asp-for="CustomerResponse" class="form-select" asp-items="Html.GetEnumSelectList<CustomerResponse>()"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Sample given</label>
                        <div class="sf-switch-row">
                            <label class="sf-switch">
                                <input asp-for="IsSampleGiven" />
                                <span class="sf-slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="SampleQuantity" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="SampleQuantity" class="form-control" type="number" step="any" min="0" />
                            <span class="input-group-text visitUnitBadge">Unit</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="CurrentBuyingPrice" class="form-label"></label>
                        <input asp-for="CurrentBuyingPrice" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="OfferPrice" class="form-label"></label>
                        <input asp-for="OfferPrice" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MonthlyRequirement" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="MonthlyRequirement" class="form-control" type="number" step="any" min="0" />
                            <span class="input-group-text visitUnitBadge">Unit</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NextFollowUpDate" class="form-label"></label>
                        <input asp-for="NextFollowUpDate" class="form-control" type="date" value="@(Model.NextFollowUpDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Remark" class="form-label"></label>
                        <textarea asp-for="Remark" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="sf-form-footer">
            <a asp-action="Index" class="sf-btn sf-btn-ghost">Cancel</a>
            <button type="submit" class="sf-btn sf-btn-primary"><i class="bi bi-check-lg"></i> Save visit</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const productLookup = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ProductData ?? new object[0]));
            const productSelect = document.getElementById('ProductId');
            const unitBadges = document.querySelectorAll('.visitUnitBadge');

            function updateUnit() {
                if (!productSelect || !unitBadges.length) return;
                const match = productLookup.find(p => p.id === productSelect.value);
                const unit = (match && match.unit) ? match.unit : 'Unit';
                unitBadges.forEach(b => b.textContent = unit);
            }

            if (productSelect) {
                productSelect.addEventListener('change', updateUnit);
                updateUnit();
            }
        });
    </script>
}
